# Separate tag for bounded v2; historical sandbox images/results stay unchanged.
FROM nvcr.io/nvidia/base/ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /usr/local/bin/uv
RUN useradd -m -u 1001 -s /bin/bash sandbox
WORKDIR /sandbox
COPY pyproject.toml uv.lock README.md /sandbox/app/
COPY src /sandbox/app/src
COPY configs /sandbox/app/configs
COPY tests /sandbox/app/tests
# Only the reused public worker; no results, checkpoints or private artifacts.
COPY evals/grounded_active_model_call.py /sandbox/app/evals/grounded_active_model_call.py
RUN cd /sandbox/app && UV_PROJECT_ENVIRONMENT=/sandbox/app/.venv UV_PYTHON_DOWNLOADS=never \
    uv sync --frozen --python /usr/bin/python3.12 \
    && chmod -R a+rX,go-w /sandbox/app
ENV TRIAGE_WORKSPACE=/sandbox/workspace PATH=/sandbox/app/.venv/bin:$PATH PYTHONUTF8=1
